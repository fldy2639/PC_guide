{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc_guide.local/schemas/hardware_catalog/v1/cpu.schema.json",
  "title": "CPU",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "sku_id", "category", "component_type", "name", "price", "current_price", "tags"],
  "properties": {
    "id": { "type": "string" },
    "sku_id": { "type": "string" },
    "category": { "type": "string" },
    "component_type": { "type": "string" },
    "brand": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "price": { "type": ["number", "integer"] },
    "current_price": { "type": ["number", "integer", "null"] },
    "jd_url": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "socket": { "type": ["string", "null"] },
    "cores": { "type": ["integer", "null"] },
    "threads": { "type": ["integer", "null"] },
    "tdp_w": { "type": ["number", "integer", "null"] },
    "has_integrated_graphics": { "type": ["boolean", "string", "null"] },
    "cpu_single_core_score": { "type": ["number", "integer", "null"] },
    "cpu_multi_core_score": { "type": ["number", "integer", "null"] }
  }
}
