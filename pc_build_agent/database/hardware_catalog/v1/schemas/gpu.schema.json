{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc_guide.local/schemas/hardware_catalog/v1/gpu.schema.json",
  "title": "GPU",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "sku_id", "category", "component_type", "name", "price", "current_price", "tags"],
  "properties": {
    "id": { "type": "string" },
    "sku_id": { "type": "string" },
    "category": { "type": "string" },
    "component_type": { "type": "string" },
    "brand": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "price": { "type": ["number", "integer"] },
    "current_price": { "type": ["number", "integer", "null"] },
    "jd_url": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "vram_gb": { "type": ["number", "integer", "null"] },
    "tbp_w": { "type": ["number", "integer", "null"] },
    "recommended_psu_w": { "type": ["number", "integer", "null"] },
    "gpu_length_mm": { "type": ["number", "integer", "null"] },
    "slot_width": { "type": ["number", "integer", "null"] },
    "gpu_performance_score": { "type": ["number", "integer", "null"] },
    "gaming_score": { "type": ["number", "integer", "null"] },
    "ai_score": { "type": ["number", "integer", "null"] },
    "power_connectors": { "type": ["array", "string", "null"], "items": { "type": "string" } }
  }
}
