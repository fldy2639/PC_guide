{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc_guide.local/schemas/hardware_catalog/v1/ssd.schema.json",
  "title": "SSD",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "sku_id", "category", "component_type", "name", "price", "current_price", "tags"],
  "properties": {
    "id": { "type": "string" },
    "sku_id": { "type": "string" },
    "category": { "type": "string" },
    "component_type": { "type": "string" },
    "brand": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "price": { "type": ["number", "integer"] },
    "current_price": { "type": ["number", "integer", "null"] },
    "jd_url": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "capacity_gb": { "type": ["number", "integer", "null"] },
    "interface": { "type": ["string", "null"] },
    "protocol": { "type": ["string", "null"] },
    "form_factor": { "type": ["string", "null"] },
    "ssd_performance_score": { "type": ["number", "integer", "null"] },
    "endurance_score": { "type": ["number", "integer", "null"] }
  }
}
