{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc_guide.local/schemas/hardware_catalog/v1/cooling.schema.json",
  "title": "Cooling",
  "type": "object",
  "additionalProperties": true,
  "required": ["id", "sku_id", "category", "component_type", "name", "price", "current_price", "tags"],
  "properties": {
    "id": { "type": "string" },
    "sku_id": { "type": "string" },
    "category": { "type": "string" },
    "component_type": { "type": "string" },
    "brand": { "type": ["string", "null"] },
    "model": { "type": ["string", "null"] },
    "name": { "type": "string" },
    "price": { "type": ["number", "integer"] },
    "current_price": { "type": ["number", "integer", "null"] },
    "jd_url": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "cooling_type": { "type": ["string", "null"] },
    "supported_sockets": { "type": ["array", "string", "null"], "items": { "type": "string" } },
    "cooler_height_mm": { "type": ["number", "integer", "null"] },
    "radiator_size_mm": { "type": ["number", "integer", "null"] },
    "cooling_capacity_w": { "type": ["number", "integer", "null"] },
    "noise_score": { "type": ["number", "integer", "null"] },
    "rgb": { "type": ["boolean", "string", "null"] }
  }
}
