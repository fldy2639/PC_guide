{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pc_guide.local/schemas/hardware_catalog/v1/cooling.schema.json",
  "title": "Cooling",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "brand", "model", "cooler_type", "tdp_rating_w"],
  "properties": {
    "id": { "type": "string" },
    "brand": { "type": "string" },
    "model": { "type": "string" },
    "cooler_type": { "type": "string", "enum": ["Air", "AIO", "Passive"] },
    "tdp_rating_w": { "type": "integer", "minimum": 1 },
    "height_mm": { "type": ["integer", "null"] },
    "radiator_mm": { "type": ["integer", "null"] },
    "socket_support": { "type": "array", "items": { "type": "string" } },
    "noise_max_db": { "type": ["number", "null"] },
    "notes": { "type": ["string", "null"] }
  }
}
