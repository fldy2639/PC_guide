# DeepSeek（或 OpenAI 兼容网关）密钥：请勿将真实密钥提交到 Git
DEEPSEEK_API_KEY=your-api-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
PC_GUIDE_DB_PATH=./data/pc_guide_sessions.sqlite
PC_GUIDE_PRODUCTS_PATH=./pc_build_agent/data/products.json
PC_GUIDE_RULES_PATH=./pc_build_agent/data/rules.json

# 为 true 时所有 recommend 响应附带 data.debug_llm（完整 prompt + 上游 message，含 reasoning_content 若存在）
PC_GUIDE_DEBUG_LLM=false

# 前后端分离：浏览器可跨域访问本 API 的 Origin 白名单，逗号分隔（须含协议、主机、端口，与前端页面完全一致）
# 示例为本地常用静态服务器端口；生产改为 https://your-cdn-domain
PC_GUIDE_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173,http://127.0.0.1:8080,http://localhost:8080,http://127.0.0.1:3000,http://localhost:3000
